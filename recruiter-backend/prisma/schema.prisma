// Fonte de verdade do schema. Toda alteração aqui vira migration versionada.
// O client gerado vai para src/generated/ para ficar dentro do rootDir do
// `nest build`; é artefato, não é versionado.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Fluxo esperado: rascunho -> aplicado -> triagem -> entrevista -> teste ->
/// oferta. `rejeitado` pode vir de qualquer estágio.
enum ApplicationStatus {
  rascunho
  aplicado
  triagem
  entrevista
  teste
  oferta
  rejeitado
}

/// De onde veio a transição de status. `ia` significa que um modelo leu um
/// email e sugeriu a mudança, e você a CONFIRMOU — o evento só existe depois
/// do clique. Sugestão pendente não é evento: mora em `EmailMessage`.
enum StatusEventSource {
  manual
  email
  ia
}

enum WorkModel {
  remoto
  hibrido
  presencial
}

enum ContractType {
  clt
  pj
  estagio
  temporario
}

// ---------------------------------------------------------------------------
// Modelos
// ---------------------------------------------------------------------------

/// Raiz do modelo. Hoje é apenas um seletor — não há login e todos os perfis
/// pertencem ao mesmo usuário. Se um dia virar multi-usuário, é aqui que entra
/// o vínculo com uma conta, sem remodelar o resto.
model Profile {
  id             String   @id @default(cuid())
  name           String
  /// Diferencia perfis do mesmo dono, ex.: "Backend Sênior" x "Tech Lead".
  headline       String?
  email          String?
  phone          String?
  location       String?
  /// { github, linkedin, site, ... } — validado com Zod na borda do Nest.
  links          Json?
  /// CV estruturado base (experiências, skills, projetos), validado com Zod.
  resume         Json?
  /// Filtro da descoberta de vagas: escopo, modalidade, contrato, senioridade
  /// e stacks preferidas. Validado com Zod na borda, como `links` e `resume`.
  /// Não vem em export nenhum — imune ao import do LinkedIn.
  jobPreferences Json?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications   Application[]
  resumeVersions ResumeVersion[]
  interviewPreps InterviewPrep[]
  emailMessages  EmailMessage[]
  savedJobs      SavedJob[]
  dismissedJobs  DismissedJob[]
  discoveredJobs DiscoveredJob[]
}

/// Vaga que este perfil recusou na descoberta.
///
/// Guarda a URL crua, e não um jobId: vaga descartada nunca vira linha em
/// `Job` — só salvar materializa. É por isso que a URL precisa ser canônica
/// antes de chegar aqui, senão o mesmo anúncio com dois endereços escapa do
/// descarte e volta na rodada seguinte.
///
/// Empresa, cargo e origem ficam desnormalizados de propósito: sem eles o
/// "desfazer" morre ao recarregar a página, e numa tela de triagem rápida o
/// clique errado é comum.
model DismissedJob {
  id          String   @id @default(cuid())
  profileId   String
  jobUrl      String
  company     String
  title       String
  source      String
  dismissedAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobUrl])
  @@index([profileId, dismissedAt])
}

/// Vaga que a descoberta chegou a te MOSTRAR.
///
/// A descoberta é sem estado: faz o leque de fontes ao vivo, guarda 15 minutos
/// em memória e descarta. Sem esta tabela não existe resposta para "quantas
/// vagas recebi" — `Job.createdAt` é a data em que a vaga foi SALVA, não em
/// que apareceu.
///
/// Grava o lote devolvido, não tudo o que as fontes trouxeram: "recebeu"
/// significa "foi mostrada a você". As ~2.000 que o leque produz por rodada
/// são em maioria filtradas e nunca vistas, e contá-las diria que você recebe
/// duas mil vagas por dia — as mesmas, todo dia.
///
/// Por perfil, porque o filtro é por perfil: a mesma vaga mostrada a dois
/// perfis são dois recebimentos.
///
/// É também o denominador que falta — hoje `DismissedJob` existe sem nada
/// contra o que dividir.
model DiscoveredJob {
  id        String @id @default(cuid())
  profileId String

  /// Canônica, pela mesma `canonicalJobUrl` de `Job.url` e `DismissedJob.jobUrl`.
  /// Aplicada no ponto de escrita, não assumida — ver `JobService.recordSeen`.
  url    String
  source String

  firstSeenAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, url])
  @@index([profileId, firstSeenAt])
}

/// A vaga em si. Não tem profileId de propósito: a vaga é da empresa, e dois
/// perfis podem se candidatar à mesma.
model Job {
  id String @id @default(cuid())

  /// Único para permitir deduplicação ao colar o mesmo link duas vezes.
  /// NULL não colide no Postgres, então vagas sem URL convivem.
  url         String? @unique
  company     String
  title       String
  /// CONTEÚDO NÃO CONFIÁVEL: descrição vinda de página externa. É dado, nunca
  /// instrução. Ver seção 5 do CLAUDE.md.
  description String?

  stack        String[]
  requirements String[]
  benefits     String[]
  seniority    String?
  workModel    WorkModel?
  contractType ContractType?
  location     String?

  /// Faixa salarial numérica, e não texto livre: é o que permite a tela de
  /// métricas responder "qual a faixa das vagas que viraram entrevista?".
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String? @default("BRL")

  /// Jornada semanal em horas.
  weeklyHours Int?
  /// linkedin, greenhouse, lever, gupy, manual...
  source      String?
  /// Quando o Claude extraiu os campos acima a partir da URL.
  extractedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications   Application[]
  savedBy        SavedJob[]
  resumeVersions ResumeVersion[]
  interviewPreps InterviewPrep[]
}

/// Vaga guardada por um perfil para aplicar depois.
///
/// É entidade própria, e não um campo em Job, porque `Job` não tem
/// `profileId` de propósito — a vaga é da empresa. Salvar é um ato do perfil,
/// e dois perfis podem salvar a mesma vaga sem interferir um no outro.
///
/// A vaga permanece salva depois de aplicada: a tela troca o botão para
/// "acompanhar candidatura" em vez de removê-la da lista.
model SavedJob {
  id        String   @id @default(cuid())
  profileId String
  jobId     String
  savedAt   DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobId])
  @@index([profileId, savedAt])
}

/// A candidatura: um perfil aplicando a uma vaga.
model Application {
  id              String  @id @default(cuid())
  profileId       String
  jobId           String
  resumeVersionId String?

  status    ApplicationStatus @default(rascunho)
  notes     String?
  appliedAt DateTime?

  /// Soft delete. Preenchido, a candidatura deixa de existir para o negócio:
  /// some da listagem e das métricas. A linha fica só para recuperação.
  deletedAt DateTime?

  /// Quando o próximo lembrete de follow-up vence, se você já agiu sobre ele.
  ///
  /// Nulo é o caso comum: o lembrete vence pela regra do status (a última
  /// mudança mais o prazo daquele status — ver `follow-up.ts`). Preenchido por
  /// "fiz o follow-up" ou "adiar", e zerado a cada mudança de status: status
  /// novo, relógio novo.
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Restrict: apagar uma vaga com candidatura registrada apagaria histórico.
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)

  statusEvents StatusEvent[]
  emails       EmailMessage[]

  /// NÃO recolocar `@@unique([profileId, jobId])` aqui.
  ///
  /// A regra continua valendo — o mesmo perfil não tem duas candidaturas
  /// ATIVAS para a mesma vaga — mas com soft delete um unique comum quebraria
  /// o caso de excluir e registrar de novo: a linha excluída seguiria ocupando
  /// o par. O correto seria um índice parcial (WHERE "deletedAt" IS NULL), que
  /// o Prisma não expressa no schema: criado por SQL cru, ele vira drift e a
  /// migration seguinte geraria um DROP dele.
  ///
  /// A regra é garantida em ApplicationService.create(), dentro da transação.
  @@index([profileId, status])
  @@index([profileId, updatedAt])
  @@index([profileId, deletedAt])
}

/// Histórico de transições. É o que gera as métricas ("quantas viraram
/// entrevista?"). Nunca sobrescrever `Application.status` sem gravar o evento.
model StatusEvent {
  id             String  @id @default(cuid())
  applicationId  String
  emailMessageId String?

  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus
  source     StatusEventSource  @default(manual)
  note       String?

  /// Quando a mudança ACONTECEU — não quando foi registrada.
  ///
  /// São perguntas diferentes: a entrevista foi marcada na segunda, você
  /// registrou na quarta. Com só `createdAt`, "tempo até a primeira resposta"
  /// media o seu hábito de registro, não a velocidade da empresa — das
  /// transições reais do banco, quatro estavam a segundos uma da outra.
  ///
  /// O padrão é o momento do registro, e a data pode ser corrigida depois
  /// pela linha do tempo. Eventos anteriores a esta coluna herdaram o
  /// `createdAt`, que é o melhor que se sabia deles.
  occurredAt DateTime @default(now())

  /// Quando o evento foi gravado. Não muda, nem quando `occurredAt` é corrigido.
  createdAt DateTime @default(now())

  application  Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  @@index([applicationId, occurredAt])
}

/// Snapshot imutável do CV enviado em uma candidatura. Guardar o conteúdo (e
/// não só um ponteiro para o Profile) é o que permite saber o que a empresa
/// realmente recebeu, mesmo depois de o CV base mudar.
model ResumeVersion {
  id        String @id @default(cuid())
  profileId String

  /// Preenchido só na versão adaptada para uma vaga. Nula é o currículo base
  /// congelado: é contra ela que cada candidatura nova compara o currículo
  /// para decidir se reaproveita a versão ou cria outra.
  jobId String?

  /// Ex.: "backend sênior — vaga X".
  label   String
  content Json
  /// Caminho do PDF renderizado, fora do versionamento.
  pdfPath String?

  createdAt DateTime @default(now())

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// SetNull: a versão é o registro do que foi enviado, e sobrevive à vaga.
  job          Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([profileId, createdAt])
  @@index([profileId, jobId, createdAt])
}

/// Preparação para entrevista de uma vaga, gerada pelo Claude. Guardada porque
/// é lida no dia da entrevista, dias depois de gerada, e gerar de novo é pago.
model InterviewPrep {
  id        String  @id @default(cuid())
  profileId String
  jobId     String
  /// O que você contou da etapa ("técnica com o tech lead"), quando contou.
  context   String?
  content   Json

  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([profileId, jobId, createdAt])
}

/// Email ingerido por IMAP, vinculado ou não a uma candidatura.
model EmailMessage {
  id            String  @id @default(cuid())
  profileId     String
  applicationId String?

  /// Message-ID do header. Junto com profileId evita reprocessar o mesmo email.
  messageId   String
  threadId    String?
  fromAddress String
  fromName    String?
  subject     String
  receivedAt  DateTime
  /// CONTEÚDO NÃO CONFIÁVEL: corpo de email de terceiros. É dado, nunca
  /// instrução. Ver seção 5 do CLAUDE.md.
  bodyText    String?

  /// O servidor de email confirmou que o remetente é quem diz ser (SPF, DKIM
  /// ou DMARC, para o domínio do "De"). Só email verificado é vinculado
  /// sozinho e lido pelo modelo — ver `sender-auth.ts`.
  ///
  /// Nulo nos emails guardados antes desta coluna: não se sabe, e "não se
  /// sabe" é tratado como não verificado até uma sincronização reler o email.
  senderVerified Boolean?

  /// Nulo enquanto o job de classificação não rodou.
  processedAt DateTime?

  /// O status que o modelo leu no email. SUGESTÃO, nunca estado: só vira
  /// `Application.status` quando você confirma (seção 4 do CLAUDE.md).
  /// Nulo quando o email não indica mudança nenhuma.
  suggestedStatus      ApplicationStatus?
  /// Por que o modelo sugeriu — texto GERADO a partir de conteúdo não
  /// confiável. Vai para a tela como texto, e só.
  suggestionNote       String?
  /// Você confirmou ou dispensou. A partir daqui a sugestão não aparece mais.
  suggestionResolvedAt DateTime?

  /// Você tirou este email da tela de pendentes. A linha fica: apagar faria a
  /// próxima sincronização trazê-lo de volta como novo, e o "desfazer" não
  /// teria o que restaurar. Descartado não é revinculado sozinho.
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  statusEvents StatusEvent[]

  @@unique([profileId, messageId])
  @@index([applicationId])
  @@index([profileId, receivedAt])
}
